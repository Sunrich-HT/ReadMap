# =============================================================================
# ReadMap — Environment Configuration
# Copy this file to .env and fill in your values.
# =============================================================================

# -----------------------------------------------------------------------------
# User Profile
# -----------------------------------------------------------------------------
USER_NAME="Researcher"
RESEARCH_LINES="Your research lines, comma-separated"
ACTIVE_PROJECT="Your current active project"

# -----------------------------------------------------------------------------
# Notion Integration (Required)
# -----------------------------------------------------------------------------
# Your Notion integration token.
# Create one at: https://www.notion.so/my-integrations
NOTION_TOKEN=

# Database IDs (find them in your Notion database URLs)
# Example: https://www.notion.so/workspace/XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX?v=...
#                                            ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
NOTION_PAPER_DB_ID=
NOTION_QUEUE_ID=
NOTION_PROJECT_DB_ID=
NOTION_CONCEPT_DB_ID=

# -----------------------------------------------------------------------------
# Optional: Semantic Scholar API Key
# Get one at: https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=

# -----------------------------------------------------------------------------
# Optional: Imgur Client ID (for image upload to Notion)
# Register an app at: https://api.imgur.com/oauth2/addclient
# Select "OAuth 2 authorization without a callback URL" for anonymous upload.
# If not set, local image paths will be kept as-is (Notion may not render them).
IMGUR_CLIENT_ID=

# -----------------------------------------------------------------------------
# Figure & table extraction (optional; requires figure-extractor)
#   pip install "readmap[figures]"
# Extraction is exhaustive by default. Which exhibits belong in a note is a
# reading judgement, so nothing is filtered unless you ask for it.
# -----------------------------------------------------------------------------
FIGURE_EXTRACTION=1
FIGURE_DPI=300
FIGURE_KINDS=all
FIGURE_TIERS=A,B,C

# -----------------------------------------------------------------------------
# Optional: interpreter that has MinerU installed.
# The README asks for a separate .venv-mineru; set this to override the search.
# -----------------------------------------------------------------------------
MINERU_PYTHON=

# -----------------------------------------------------------------------------
# Output Paths
# -----------------------------------------------------------------------------
PAPERS_OUTPUT_DIR=./papers
WIKI_OUTPUT_DIR=./wiki
