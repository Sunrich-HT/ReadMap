%% 领域地图模板 — Mindmap 形式
%% 用法：以本文核心问题为根，展开各方向、方法、关系

mindmap
  root((核心问题<br/>Core Problem))
    方向A[方向A名称]
      方法A1[方法A1<br/>作者A, 20XX]
      方法A2[方法A2<br/>作者B, 20XX]
      本文方法A[本文方法<br/>★ 创新点]
    方向B[方向B名称]
      方法B1[方法B1]
      方法B2[方法B2]
    方向C[较少探索方向]
      方法C1[潜在机会]
    
    %% 标注竞争/合作关系
    本文方法A -->|改进自| 方法A2
    本文方法A -->|对比| 方法B1
